<UserControl x:Class="CantineUI.RechercheArticle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CantineUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:RechercheArticleVM></local:RechercheArticleVM>
    </UserControl.DataContext>
    <StackPanel>
        <Label>Texte à rechercher</Label>
        <TextBox Text="{Binding Search.SearchText, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <Button Command="{Binding FetchArticlesCommand}">Rechercher</Button>
        <ListBox ItemsSource="{Binding Resultats}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="20" Height="20" Fill="Red" Margin="3px"></Ellipse>
                        <TextBlock Text="{Binding Libelle}"></TextBlock>
                        <TextBlock Text=" "></TextBlock>

                        <TextBlock Text="{Binding Prix}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
